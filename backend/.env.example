NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173

# Supabase project API credentials. Use a development project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-or-publishable-key

# Server-only; leave blank unless a privileged callback/storage operation needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider settings; integrations remain unavailable until implemented/configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
ML_VOICE_SERVICE_URL=
ML_STRATEGY_SERVICE_URL=
ML_SERVICE_AUTH_TOKEN=
LOG_LEVEL=info
