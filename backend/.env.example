NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:5173

# Local PostgreSQL connection. Keep credentials out of source control.
DATABASE_URL=postgres://baaki_app:replace-with-local-password@127.0.0.1:5432/baaki

# Generate a random value of at least 32 characters. Never use a frontend variable.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=30m

# Optional provider and model-service settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
N8N_BASE_URL=https://adil897.app.n8n.cloud/webhook/0029bf9f-d163-4ea4-931d-93641b65e110
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT_MS=15000
N8N_ENABLED=true
ML_VOICE_SERVICE_URL=
ML_STRATEGY_SERVICE_URL=
ML_SERVICE_AUTH_TOKEN=
LOG_LEVEL=info
